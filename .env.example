# ===================================================
# ChemRAG — Environment Configuration
# ===================================================
# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.
# ===================================================

# ----- Application -----
APP_ENV=development           # development | test | production
APP_SECRET_KEY=change-me-to-a-random-256-bit-hex-string
APP_DEBUG=true
APP_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# ----- Allow in-memory fallback (set to false in real development) -----
# When false, the application will raise an error if PostgreSQL/Redis are unavailable.
# Only set to true in pure unit tests that don't need a real DB.
ALLOW_IN_MEMORY_FALLBACK=false

# ----- Backend API -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1             # increase in production
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- PostgreSQL (with pgvector) -----
# When running locally (not inside Docker):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chemrag
POSTGRES_USER=chemrag
POSTGRES_PASSWORD=ChemRAG_dev_2024!

# Async URL (used by FastAPI / SQLAlchemy async engine)
DATABASE_URL=postgresql+asyncpg://chemrag:ChemRAG_dev_2024!@localhost:5432/chemrag

# Sync URL (used by Alembic migrations)
SYNC_DATABASE_URL=postgresql+psycopg://chemrag:ChemRAG_dev_2024!@localhost:5432/chemrag

# When running INSIDE Docker Compose, override these:
# POSTGRES_HOST=postgres
# DATABASE_URL=postgresql+asyncpg://chemrag:ChemRAG_dev_2024!@postgres:5432/chemrag
# SYNC_DATABASE_URL=postgresql+psycopg://chemrag:ChemRAG_dev_2024!@postgres:5432/chemrag

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# When running INSIDE Docker Compose, override:
# REDIS_HOST=redis
# REDIS_URL=redis://redis:6379/0

# ----- Storage (local or S3-compatible) -----
STORAGE_BACKEND=local         # local | s3 | gcs
STORAGE_LOCAL_PATH=./data/uploads
# S3 (leave blank if using local)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# ----- LLM Provider -----
LLM_PROVIDER=openai           # openai | anthropic | google | ollama
LLM_ENABLED=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-with-your-key
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_RETRIES=3
LLM_RATE_LIMIT_RPM=500

# ----- Embeddings -----
EMBEDDING_PROVIDER=openai     # openai | sentence-transformers | matryoshka
EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-replace-with-your-key
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_TIMEOUT=30
EMBEDDING_RETRIES=3
EMBEDDING_RATE_LIMIT_RPM=3000

# ----- Reranker -----
RERANKER_ENABLED=true
RERANKER_PROVIDER=cohere      # cohere | cross-encoder | jina
RERANKER_BASE_URL=https://api.cohere.ai
RERANKER_API_KEY=
RERANKER_MODEL=rerank-english-v3.0
RERANKER_TOP_N=5
RERANKER_TIMEOUT=20
RERANKER_RETRIES=3
RERANKER_RATE_LIMIT_RPM=100

# ----- GROBID (Scientific PDF Parser) -----
GROBID_ENABLED=true
GROBID_BASE_URL=http://localhost:8070
GROBID_TIMEOUT=120
GROBID_RETRIES=3
GROBID_RATE_LIMIT_RPM=60

# ----- DECIMER (Chemical Structure Recognition from images) -----
DECIMER_ENABLED=true
DECIMER_BASE_URL=http://localhost:8082
DECIMER_TIMEOUT=60
DECIMER_RETRIES=2
DECIMER_RATE_LIMIT_RPM=30

# ----- MolScribe (Molecule Image to SMILES) -----
MOLSCRIBE_ENABLED=true
MOLSCRIBE_BASE_URL=http://localhost:8083
MOLSCRIBE_TIMEOUT=60
MOLSCRIBE_RETRIES=2
MOLSCRIBE_RATE_LIMIT_RPM=30

# ----- PubChem (Chemical Normalization & Lookup) -----
PUBCHEM_ENABLED=true
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
PUBCHEM_TIMEOUT=30
PUBCHEM_RETRIES=3
PUBCHEM_RATE_LIMIT_RPM=100

# ----- Security -----
JWT_SECRET_KEY=change-me-to-a-random-256-bit-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_HOSTS=localhost,127.0.0.1

# ----- Safety & Compliance -----
SAFETY_ENABLED=true
SAFETY_BLOCK_WEAPONS_SYNTHESIS=true
SAFETY_BLOCK_CONTROLLED_SUBSTANCES=true
SAFETY_CONFIDENCE_THRESHOLD=0.85

# ----- Observability -----
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=chemrag-backend
OTEL_TRACE_SAMPLE_RATE=1.0
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# ----- Evaluation -----
EVALUATION_ENABLED=false
EVALUATION_DATASET_PATH=./data/eval
RAGAS_ENABLED=false
